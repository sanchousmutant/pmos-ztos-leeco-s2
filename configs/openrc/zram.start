#!/bin/sh
# zram swap for LeEco Le 2 (s2): 2.7 GiB RAM is tight for ztMETRO/Chromium.
# Compressed RAM is much faster than eMMC and does not wear the flash.
# Runs from /etc/local.d at boot; safe to re-run.

DEV=/dev/zram0
[ -e "$DEV" ] || exit 0

if grep -q "^$DEV " /proc/swaps 2>/dev/null; then
	exit 0
fi

# 50% of RAM, capped at 2 GiB.
mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
size_mb=$((mem_kb / 1024 / 2))
[ "$size_mb" -gt 2048 ] && size_mb=2048
[ "$size_mb" -lt 256 ] && size_mb=256

echo 1 > /sys/block/zram0/reset 2>/dev/null || true
echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null || true
echo $((size_mb * 1024 * 1024)) > /sys/block/zram0/disksize || exit 1
mkswap "$DEV" >/dev/null 2>&1 || exit 1
swapon -p 100 "$DEV" || exit 1

# Aggressive zram offloading (zram is fast compressed RAM — use it eagerly)
echo 180 > /proc/sys/vm/swappiness 2>/dev/null || true
echo 0 > /proc/sys/vm/page-cluster 2>/dev/null || true
echo 0 > /proc/sys/vm/watermark_boost_factor 2>/dev/null || true

echo "zram: ${size_mb} MiB active on $DEV"

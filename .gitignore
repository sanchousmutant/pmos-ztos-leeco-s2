# Initramfs payloads; keep the scripts, manifests and the few needed binaries
/tiny_initramfs/bin/*
!/tiny_initramfs/bin/busybox
/tiny_initramfs/sbin/*
/tiny_initramfs_switch/bin/*
!/tiny_initramfs_switch/bin/busybox
/tiny_initramfs_switch/sbin/*
!/tiny_initramfs_switch/sbin/adbd

# Debug audio, plots and captures
/*.wav
/*.png
/*.jpg
/test_sound.txt
/*.log
/wayland.err


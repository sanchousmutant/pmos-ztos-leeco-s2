#!/bin/sh
# set-wallpaper: Set Start screen and Lock screen wallpapers in ztMETRO

CONFIG="/home/pmos/.config/ztmetro/config"

find_latest_image() {
    # Search Downloads and Pictures for the newest image file
    ls -t /home/pmos/Downloads/*.[jJ][pP][gG] \
          /home/pmos/Downloads/*.[jJ][pP][eE][gG] \
          /home/pmos/Downloads/*.[pP][nN][gG] \
          /home/pmos/Downloads/*.[wW][eE][bB][pP] \
          /home/pmos/Pictures/Wallpapers/*.[jJ][pP][gG] \
          /home/pmos/Pictures/Wallpapers/*.[jJ][pP][eE][gG] \
          /home/pmos/Pictures/Wallpapers/*.[pP][nN][gG] \
          /home/pmos/Pictures/Wallpapers/*.[wW][eE][bB][pP] 2>/dev/null | head -n 1
}

show_help() {
    echo "Usage: set-wallpaper [OPTIONS] [path_to_image]"
    echo ""
    echo "Without arguments:"
    echo "  set-wallpaper       Automatically applies the most recently downloaded image"
    echo ""
    echo "Options:"
    echo "  --start <image>     Set wallpaper only for Start screen tiles"
    echo "  --lock <image>      Set wallpaper only for Lock screen"
    echo "  --clear             Remove background photo (revert to solid accent)"
    echo "  --help              Show this help message"
    echo ""
    echo "Examples:"
    echo "  set-wallpaper"
    echo "  set-wallpaper ~/Downloads/my_photo.jpg"
}

set_key() {
    local key="$1"
    local val="$2"
    if grep -q "^${key} *=" "$CONFIG" 2>/dev/null; then
        sed -i "s|^${key} *=.*|${key} = ${val}|" "$CONFIG"
    else
        echo "${key} = ${val}" >> "$CONFIG"
    fi
}

reload_ztmetro() {
    PID=$(pidof ztmetro 2>/dev/null)
    if [ -n "$PID" ]; then
        kill -HUP "$PID" 2>/dev/null || true
    fi
}

# If no arguments provided, automatically find and apply the latest downloaded image
if [ -z "$1" ]; then
    LATEST=$(find_latest_image)
    if [ -n "$LATEST" ] && [ -f "$LATEST" ]; then
        REAL_PATH=$(readlink -f "$LATEST")
        set_key "start_wallpaper" "$REAL_PATH"
        set_key "lock_wallpaper" "$REAL_PATH"
        reload_ztmetro
        echo "Applied latest downloaded wallpaper:"
        echo "  -> $REAL_PATH"
        exit 0
    else
        echo "No images found in ~/Downloads or ~/Pictures/Wallpapers."
        echo ""
        show_help
        exit 1
    fi
fi

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "--clear" ]; then
    set_key "start_wallpaper" ""
    set_key "lock_wallpaper" ""
    reload_ztmetro
    echo "Wallpapers cleared (solid accent restored)."
    exit 0
fi

if [ "$1" = "--start" ]; then
    IMG="$2"
    [ -z "$IMG" ] && IMG=$(find_latest_image)
    if [ ! -f "$IMG" ]; then
        echo "Error: file not found: $IMG" >&2
        exit 1
    fi
    REAL_PATH=$(readlink -f "$IMG")
    set_key "start_wallpaper" "$REAL_PATH"
    reload_ztmetro
    echo "Start wallpaper updated: $REAL_PATH"
    exit 0
fi

if [ "$1" = "--lock" ]; then
    IMG="$2"
    [ -z "$IMG" ] && IMG=$(find_latest_image)
    if [ ! -f "$IMG" ]; then
        echo "Error: file not found: $IMG" >&2
        exit 1
    fi
    REAL_PATH=$(readlink -f "$IMG")
    set_key "lock_wallpaper" "$REAL_PATH"
    reload_ztmetro
    echo "Lock screen wallpaper updated: $REAL_PATH"
    exit 0
fi

IMG="$1"
if [ ! -f "$IMG" ]; then
    echo "Error: file not found: $IMG" >&2
    exit 1
fi
REAL_PATH=$(readlink -f "$IMG")
set_key "start_wallpaper" "$REAL_PATH"
set_key "lock_wallpaper" "$REAL_PATH"
reload_ztmetro
echo "Start and Lock screen wallpaper set to: $REAL_PATH"
